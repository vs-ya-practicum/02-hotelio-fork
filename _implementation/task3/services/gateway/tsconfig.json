{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "baseUrl": ".",
        "rootDir": ".",
        "outDir": ".delivery/.builds/dist",
        "tsBuildInfoFile": ".delivery/.temp/gateway.tsbuildinfo",
        "types": ["vite/client"],
        "paths": {
            "@src/*": ["./src/*"],
            "@tests/*": ["./tests/*"],
            "@fixtures/*": ["./tests/foundation/.ancillary/fixtures/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "tests/**/*.test.ts",
        "tests/**/*.d.ts",
        "tests/foundation/.ancillary/fixtures/**/*.ts"
    ],
    "exclude": [".delivery/.builds/**", ".delivery/.temp/**"]
}
