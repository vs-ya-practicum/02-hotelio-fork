{
    "name": "task3-implementation",
    "private": true,
    "type": "module",
    "workspaces": [
        "*-subgraph",
        "gateway"
    ],
    "scripts": {
        "build": "tsc",
        "booking:compose:up": "docker compose -f .delivery/booking-subgraph/subgraph.compose.yml up --build",
        "booking:compose:build": "docker compose -f booking-subgraph/.delivery/booking-subgraph.compose.yml build --no-cache booking-service",
        "booking:compose:run": "npm run booking:compose:build && npm run booking:compose:up",
        "booking:compose:down": "docker compose -f booking-subgraph/.delivery/booking-subgraph.compose.yml down",
        "test": "vitest run --config .testing/vitest.workspace.ts",
        "lint": "eslint .",
        "check-types": "npx tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^10.10.0",
        "prettier": "^3.9.6",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^4.1.11"
    }
}
